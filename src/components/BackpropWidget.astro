---
/**
 * Interactive backpropagation gate-pattern visualization.
 * Walks through forward/backward passes of f(x,y,z) = (x+y) * z
 * with step-by-step explanations.
 * Supports dark/light mode via data-theme attribute.
 */
import katex from 'katex';
const symAdd = katex.renderToString('+', { throwOnError: false });
const symMul = katex.renderToString('\\times', { throwOnError: false });
---

<div class="bp-widget">
  <div class="bp-header">
    <span class="bp-title">Backprop Intuition</span>
    <span class="bp-step-lbl" id="bp-step-lbl">1 / 7</span>
  </div>

  <div class="bp-prog" id="bp-prog"></div>

  <div class="bp-circuit-wrap">
    <div class="bp-circuit-inner">
    <div class="bp-eq-overlay" id="bp-eq-overlay"></div>
    <div class="bp-lbl-layer" id="bp-lbl-layer"></div>
    <svg id="bp-ckt" viewBox="0 0 720 260" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <marker id="bp-ah-off" markerWidth="7" markerHeight="5" refX="7" refY="2.5" orient="auto">
          <path d="M0,0 L7,2.5 L0,5 z" class="bp-mk-off"/>
        </marker>
        <marker id="bp-ah-fwd" markerWidth="7" markerHeight="5" refX="7" refY="2.5" orient="auto">
          <path d="M0,0 L7,2.5 L0,5 z" class="bp-mk-fwd"/>
        </marker>
        <marker id="bp-ah-bwd" markerWidth="7" markerHeight="5" refX="7" refY="2.5" orient="auto">
          <path d="M0,0 L7,2.5 L0,5 z" class="bp-mk-grad"/>
        </marker>
      </defs>

      <!-- EDGES -->
      <!--
        Edge rule: every forward edge has a gradient rail at a constant 6px
        offset on both horizontal and vertical segments. The gradient rail
        is always on the outer side of the first bend (above/east for edges
        that go down, below/east for edges that go up). All edges into one
        gate bend at the same x, 40px before the gate's left edge (forward
        rails at gate-40, gradient rails at gate-34).
      -->
      <!-- x → ADD -->
      <path id="bp-pe1" class="bp-edge bp-edge-fwdline" d="M 140 55 H 225 V 86 H 266" fill="none" marker-end="url(#bp-ah-off)"/>
      <!-- y → ADD -->
      <path id="bp-pe2" class="bp-edge bp-edge-fwdline" d="M 140 130 H 225 V 98 H 266" fill="none" marker-end="url(#bp-ah-off)"/>
      <path id="bp-pe1b" class="bp-edge bp-edge-grad" d="M 270 80 H 231 V 49 H 140" fill="none" marker-end="url(#bp-ah-bwd)" opacity="0"/>
      <path id="bp-pe2b" class="bp-edge bp-edge-grad" d="M 270 104 H 231 V 136 H 140" fill="none" marker-end="url(#bp-ah-bwd)" opacity="0"/>

      <!-- ADD → MUL -->
      <path id="bp-pe3" class="bp-edge bp-edge-fwdline" d="M 337 92 H 385 V 151 H 426" fill="none" marker-end="url(#bp-ah-off)"/>
      <!-- z → MUL -->
      <path id="bp-pe4" class="bp-edge bp-edge-fwdline" d="M 140 205 H 385 V 163 H 426" fill="none" marker-end="url(#bp-ah-off)"/>
      <path id="bp-pe3b" class="bp-edge bp-edge-grad" d="M 430 145 H 391 V 86 H 337" fill="none" marker-end="url(#bp-ah-bwd)" opacity="0"/>
      <path id="bp-pe4b" class="bp-edge bp-edge-grad" d="M 430 169 H 391 V 211 H 140" fill="none" marker-end="url(#bp-ah-bwd)" opacity="0"/>

      <!-- MUL → Output -->
      <path id="bp-pe5" class="bp-edge bp-edge-fwdline" d="M 497 157 H 560" fill="none" marker-end="url(#bp-ah-off)"/>
      <path id="bp-pe5b" class="bp-edge bp-edge-grad" d="M 560 151 H 497" fill="none" marker-end="url(#bp-ah-bwd)" opacity="0"/>

      <!-- Value labels are KaTeX HTML elements in #bp-lbl-layer (see script). -->

      <!-- INPUT NODES -->
      <rect class="bp-node-rect" x="30" y="35" width="110" height="40" rx="7"/>
      <text x="85" y="48" text-anchor="middle"
        class="bp-node-label" font-size="10">입력</text>

      <rect class="bp-node-rect" x="30" y="110" width="110" height="40" rx="7"/>
      <text x="85" y="123" text-anchor="middle"
        class="bp-node-label" font-size="10">입력</text>

      <rect class="bp-node-rect" x="30" y="185" width="110" height="40" rx="7"/>
      <text x="85" y="198" text-anchor="middle"
        class="bp-node-label" font-size="10">입력</text>

      <!-- GATES -->
      <rect id="bp-r-add" class="bp-gate-rect" x="265" y="74" width="72" height="36" rx="18"
        stroke-width="1.5"/>

      <rect id="bp-r-mul" class="bp-gate-rect" x="425" y="139" width="72" height="36" rx="18"
        stroke-width="1.5"/>

      <!-- OUTPUT -->
      <rect class="bp-node-rect" x="560" y="139" width="112" height="36" rx="7"/>
      <text x="616" y="152" text-anchor="middle"
        class="bp-node-label" font-size="10">출력</text>

      <!-- LEGEND -->
      <line x1="586" y1="20" x2="606" y2="20" class="bp-legend-fwd"/>
      <text class="bp-legend-txt" x="612" y="24" font-size="11">forward 값</text>
      <line x1="586" y1="38" x2="606" y2="38" class="bp-legend-grad"/>
      <text class="bp-legend-txt" x="612" y="42" font-size="11">gradient</text>
      <line x1="586" y1="56" x2="606" y2="56" class="bp-legend-local"/>
      <text class="bp-legend-txt" x="612" y="60" font-size="11">local gradient</text>
    </svg>
    </div>
  </div>
  <p class="bp-scroll-hint">회로가 잘려 보이면 옆으로 밀어서 보세요.</p>

  <!-- Nav: above the description so its position does not move between steps -->
  <div class="bp-nav">
    <button id="bp-btn-prev" class="bp-btn" type="button" disabled>← 이전</button>
    <button id="bp-btn-next" class="bp-btn" type="button">다음 →</button>
    <button id="bp-btn-reset" class="bp-btn bp-btn-reset" type="button" aria-label="처음으로">↻</button>
  </div>

  <div class="bp-body">
    <!-- Left: description -->
    <div class="bp-left">
      <div class="bp-desc">
        <div id="bp-phase-tag" class="bp-phase bp-ph-init">준비</div>
        <div class="bp-desc-title" id="bp-desc-title">회로 초기화</div>
        <div class="bp-desc-body" id="bp-desc-body"></div>
      </div>
    </div>

    <!-- Right: gate cards stacked -->
    <div class="bp-right">
      <div class="bp-gc bp-gc-add" id="bp-gc-add">
        <div class="bp-gc-name">ADD gate <span class="bp-gc-sym" set:html={symAdd}></span></div>
        <div class="bp-gc-rule" id="bp-gr-add"></div>
        <div class="bp-gc-formula" id="bp-gf-add"></div>
      </div>
      <div class="bp-gc bp-gc-mul" id="bp-gc-mul">
        <div class="bp-gc-name">MUL gate <span class="bp-gc-sym" set:html={symMul}></span></div>
        <div class="bp-gc-rule" id="bp-gr-mul"></div>
        <div class="bp-gc-formula" id="bp-gf-mul"></div>
      </div>
    </div>
  </div>

</div>

<style>
  .bp-widget {
    --bp-ink: var(--text);
    --bp-muted: var(--text-muted);
    --bp-panel: var(--bg-surface);
    --bp-line: var(--border);
    --bp-idle: #c6cad0;
    --bp-fwd: #2457a6;
    --bp-fwd-soft: rgba(36, 87, 166, 0.08);
    --bp-grad: #c2410c;
    --bp-grad-soft: rgba(194, 65, 12, 0.08);
    --bp-local: #7c3aed;
    --bp-done: #2f7d5b;
    --bp-mono: 'Roboto Mono', ui-monospace, monospace;
    font-family: 'Pretendard Std', 'Pretendard', -apple-system, sans-serif;
    font-feature-settings: 'tnum' 1;
    max-width: 800px;
    margin: 0 auto;
    padding: 0.75rem 0 0;
    color: var(--bp-ink);
    outline: none;
  }
  :global([data-theme='dark']) .bp-widget {
    --bp-idle: #4b5057;
    --bp-fwd: #7fa9e6;
    --bp-fwd-soft: rgba(127, 169, 230, 0.12);
    --bp-grad: #f0915c;
    --bp-grad-soft: rgba(240, 145, 92, 0.12);
    --bp-local: #a78bfa;
    --bp-done: #6cc49a;
  }
  .bp-widget:focus-visible { box-shadow: 0 0 0 2px var(--bp-fwd); border-radius: 12px; }

  /* Header */
  .bp-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 10px;
  }
  .bp-title { font-size: 15px; font-weight: 600; letter-spacing: -0.01em; }
  .bp-step-lbl { font-size: 12px; color: var(--bp-muted); font-variant-numeric: tabular-nums; }

  /* Progress: one segment per step */
  .bp-prog { display: flex; gap: 4px; margin-bottom: 12px; }
  .bp-seg { height: 3px; flex: 1; border-radius: 3px; background: var(--bp-line); transition: background 0.25s; }
  .bp-seg-done { background: var(--bp-muted); opacity: 0.55; }
  .bp-seg-active { background: var(--bp-fwd); }

  /* Circuit panel */
  .bp-circuit-wrap {
    position: relative;
    background: var(--bp-panel);
    border-radius: 14px;
    padding: 6px 6px 2px;
    margin-bottom: 12px;
  }
  .bp-eq-overlay {
    position: absolute; top: 8px; left: 0; right: 0;
    text-align: center; pointer-events: none; z-index: 1;
    font-size: 13px; color: var(--bp-muted);
  }
  .bp-eq-overlay :global(.katex) { font-size: 1em !important; color: var(--bp-muted) !important; }
  .bp-circuit-inner { position: relative; }
  #bp-ckt { width: 100%; height: auto; display: block; }
  .bp-scroll-hint { display: none; }

  /* SVG: nodes, gates, edges */
  .bp-node-rect { fill: var(--bp-panel); stroke: rgba(0, 0, 0, 0.2); stroke-width: 1.25; }
  :global([data-theme='dark']) .bp-node-rect { stroke: #50555c; }
  .bp-node-label { fill: var(--bp-muted); font-size: 10.5px; font-family: inherit; }
  .bp-node-val { fill: var(--bp-ink); font-family: var(--bp-mono); font-size: 14px; font-weight: 500; }
  .bp-gate-rect { fill: var(--bp-panel); stroke: var(--bp-idle); stroke-width: 1.25; transition: stroke 0.25s, fill 0.25s; }
  .bp-gate-rect.is-fwd { stroke: var(--bp-fwd); fill: var(--bp-fwd-soft); stroke-width: 1.75; }
  .bp-gate-rect.is-grad { stroke: var(--bp-grad); fill: var(--bp-grad-soft); stroke-width: 1.75; }

  .bp-edge { transition: stroke 0.25s, opacity 0.25s; }
  .bp-edge-fwdline { stroke: var(--bp-idle); stroke-width: 1.75; }
  .bp-edge-fwdline.is-on { stroke: var(--bp-fwd); stroke-width: 2; }
  .bp-edge-grad { stroke: var(--bp-grad); stroke-width: 1.75; stroke-dasharray: 5 4; }
  .bp-mk-off { fill: var(--bp-idle); }
  .bp-mk-fwd { fill: var(--bp-fwd); }
  .bp-mk-grad { fill: var(--bp-grad); }

  /* Value labels: KaTeX HTML elements placed in viewBox units (percent of the SVG box) */
  .bp-circuit-inner { container-type: inline-size; }
  .bp-widget :global(.bp-lbl-layer) {
    position: absolute; inset: 0; pointer-events: none; z-index: 1;
    --bp-fs: max(11px, calc(100cqw * 13 / 720));
    font-size: var(--bp-fs);
  }
  .bp-widget :global(.bp-ol) {
    position: absolute; white-space: nowrap; line-height: 1.25;
    transition: opacity 0.25s;
  }
  .bp-widget :global(.bp-ol .katex) { font-size: 1em !important; color: inherit !important; }
  .bp-widget :global(.bp-ol-node) { font-size: 1.15em; color: var(--bp-ink); }
  .bp-widget :global(.bp-ol-gate) { font-size: 1.55em; color: var(--bp-muted); transition: color 0.25s; }
  .bp-widget :global(.bp-ol-gate.is-fwd) { color: var(--bp-fwd); }
  .bp-widget :global(.bp-ol-gate.is-grad) { color: var(--bp-grad); }
  .bp-widget :global(.bp-ol-fwd) { color: var(--bp-fwd); }
  .bp-widget :global(.bp-ol-grad) { color: var(--bp-grad); }
  .bp-widget :global(.bp-ol-local) { color: var(--bp-local); }
  .bp-desc-body :global(.bp-local-part),
  .bp-desc-body :global(.bp-local-part *) { color: var(--bp-local) !important; }

  .bp-legend-fwd { stroke: var(--bp-fwd); stroke-width: 2; }
  .bp-legend-grad { stroke: var(--bp-grad); stroke-width: 2; stroke-dasharray: 4 3; }
  .bp-legend-local { stroke: var(--bp-local); stroke-width: 2.5; stroke-dasharray: 1 3; stroke-linecap: round; }
  .bp-legend-txt { fill: var(--bp-muted); font-family: inherit; }

  /* Body: explanation and gate rules */
  .bp-body {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: 20px;
    padding: 4px 2px 0;
  }
  .bp-left { min-width: 0; }
  .bp-right { display: flex; flex-direction: column; gap: 4px; border-left: 1px solid var(--bp-line); padding-left: 16px; }

  .bp-phase {
    display: inline-flex; align-items: center; gap: 7px;
    font-size: 12px; font-weight: 500; color: var(--bp-muted);
    margin-bottom: 6px;
  }
  .bp-phase::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: currentColor; }
  .bp-ph-fwd { color: var(--bp-fwd); }
  .bp-ph-bwd { color: var(--bp-grad); }
  .bp-ph-done { color: var(--bp-done); }

  .bp-desc-title { font-size: 16px; font-weight: 600; letter-spacing: -0.01em; margin-bottom: 8px; }
  .bp-desc-body { font-size: 13.5px; line-height: 1.8; }
  .bp-desc-body :global(p) { margin: 0 0 4px; }
  .bp-widget .bp-desc-body :global(table) {
    display: table; border-collapse: collapse; width: 100%; margin: 0;
    border: 0; overflow: visible; white-space: normal; font-size: inherit;
  }
  .bp-widget .bp-desc-body :global(tr),
  .bp-widget .bp-desc-body :global(td) { border: 0; background: transparent; }
  .bp-widget .bp-desc-body :global(td) { padding: 3px 12px 3px 0; vertical-align: middle; white-space: normal; }
  .bp-desc-body :global(.katex) { font-size: 1em !important; }

  .bp-gc {
    padding: 8px 0 10px 12px;
    border-left: 2px solid transparent;
    margin-left: -14px;
    opacity: 0.45;
    transition: opacity 0.25s, border-color 0.25s;
  }
  .bp-gc + .bp-gc { border-top: 1px solid var(--bp-line); }
  .bp-gc-lit { opacity: 1; border-left-color: var(--bp-fwd); }
  .bp-widget.is-bwd .bp-gc-lit { border-left-color: var(--bp-grad); }
  .bp-gc-name { font-size: 13px; font-weight: 600; margin-bottom: 4px; display: flex; justify-content: space-between; }
  .bp-gc-sym { font-weight: 400; color: var(--bp-muted); }
  .bp-gc-rule { font-size: 12.5px; color: var(--bp-muted); line-height: 1.6; margin-bottom: 6px; }
  .bp-gc-rule :global(strong) { color: var(--bp-ink); font-weight: 600; }
  .bp-gc-formula { font-size: 12px; line-height: 2; color: var(--bp-ink); }
  .bp-widget.is-bwd .bp-gc-formula :global(.katex),
  .bp-widget.is-bwd .bp-gc-formula :global(.katex *) { color: var(--bp-grad) !important; }

  /* Navigation */
  .bp-nav { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; margin-bottom: 16px; }
  .bp-btn {
    padding: 4px 14px;
    border-radius: 6px;
    border: 1px solid var(--bp-line);
    background: var(--bp-panel);
    color: var(--bp-ink);
    font-family: inherit;
    font-size: 13px;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.15s;
  }
  .bp-btn:hover { background: var(--accent-shadow); }
  .bp-btn:disabled { opacity: 0.4; cursor: default; }
  .bp-btn:focus-visible { outline: 2px solid var(--bp-fwd); outline-offset: 2px; }
  .bp-btn-reset { margin-left: auto; }

  @media (max-width: 640px) {
    /* Keep the circuit at a readable scale and let the panel scroll sideways. */
    .bp-circuit-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; overscroll-behavior-x: contain; }
    .bp-circuit-inner { min-width: 620px; }
    #bp-ckt { max-width: none; }
    .bp-circuit-wrap { margin-bottom: 4px; }
    .bp-scroll-hint { display: block; margin: 0 0 12px; font-size: 12px; color: var(--bp-muted); text-align: right; }
    .bp-body { grid-template-columns: 1fr; gap: 12px; }
    .bp-right { border-left: 0; padding-left: 0; border-top: 1px solid var(--bp-line); padding-top: 8px; }
    .bp-gc { margin-left: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .bp-widget * { transition: none !important; }
  }
</style>

<script>
  import katex from 'katex';

  function tex(src: string): string {
    return katex.renderToString(src, { throwOnError: false, displayMode: false });
  }

  // Like tex(), but allows \htmlClass so a part of a formula can be colored via CSS.
  function texC(src: string): string {
    return katex.renderToString(src, {
      throwOnError: false, displayMode: false,
      trust: (ctx) => ctx.command === '\\htmlClass', strict: false,
    });
  }

  // Gate card formula data
  const gateFwd = {
    add: tex('f(a,\\,b) = a + b'),
    mul: tex('f(a,\\,b) = a \\times b'),
    ruleAdd: '두 입력을 <strong>더해서</strong> 출력합니다.',
    ruleMul: '두 입력을 <strong>곱해서</strong> 출력합니다.',
  };

  const gateBwd = {
    add:
      tex('\\tfrac{\\partial f}{\\partial a} = \\tfrac{\\partial f}{\\partial \\text{out}} \\cdot 1') + '<br>' +
      tex('\\tfrac{\\partial f}{\\partial b} = \\tfrac{\\partial f}{\\partial \\text{out}} \\cdot 1'),
    mul:
      tex('\\tfrac{\\partial f}{\\partial a} = \\tfrac{\\partial f}{\\partial \\text{out}} \\cdot b') + '<br>' +
      tex('\\tfrac{\\partial f}{\\partial b} = \\tfrac{\\partial f}{\\partial \\text{out}} \\cdot a'),
    ruleAdd: 'upstream gradient를 모든 입력에 <strong>그대로 전달</strong>합니다.',
    ruleMul: '입력값을 <strong>서로 교환</strong>하여 gradient를 계산합니다.',
  };

  interface Step {
    title: string;
    body: () => string;
    phase: string;
    phaseLabel: string;
    activeGate: string | null;
    fwdEdges: string[];
    bwdEdges: string[];
    flabels: string[];
    blabels: string[];
    llabels: string[];
    badges: string[];
    fVal: string;
    fColor: string;
  }

  const STEPS: Step[] = [
    {
      title: '회로 초기화',
      body: () => [
        '<p>입력값: ', tex('x = -2,\\; y = 5,\\; z = -4'), '</p>',
        '<p style="margin-top:6px">계산식: ', tex('f(x,y,z) = (x + y) \\cdot z'), '</p>',
        '<p style="margin-top:10px;color:var(--text-muted);font-size:12px">다음 버튼으로 forward pass를 시작하세요.</p>',
      ].join(''),
      phase: 'init', phaseLabel: '준비', activeGate: null,
      fwdEdges: [], bwdEdges: [], flabels: [], blabels: [], llabels: [], badges: [],
      fVal: 'f = \\text{?}', fColor: 'off',
    },
    {
      title: 'Forward Pass \u2014 ADD 게이트',
      body: () => [
        '<p>', tex('q = x + y = (-2) + 5 = 3'), '</p>',
        '<p style="margin-top:10px;margin-bottom:4px">이 시점에서 저장(cache)하는 값: 없음</p>',
        '<p style="margin-top:8px;color:var(--text-muted);font-size:12px">',
          'ADD의 local gradient는 입력값과 무관하게 1이므로 backward에 입력값이 필요 없습니다.',
        '</p>',
      ].join(''),
      phase: 'fwd', phaseLabel: 'Forward pass', activeGate: 'add',
      fwdEdges: ['e1', 'e2'], bwdEdges: [], flabels: ['e1', 'e2'], blabels: [], llabels: [], badges: [],
      fVal: 'f = \\text{?}', fColor: 'off',
    },
    {
      title: 'Forward Pass \u2014 MUL 게이트',
      body: () => [
        '<p>', tex('f = q \\cdot z = 3 \\times (-4) = -12'), '</p>',
        '<p style="margin-top:10px;margin-bottom:4px">이 시점에서 저장(cache)하는 값:</p>',
        '<p style="padding-left:10px">', tex('q = 3,\\quad z = -4'), '</p>',
        '<p style="margin-top:8px;color:var(--text-muted);font-size:12px">',
          'MUL의 local gradient는 상대 입력값이므로,',
          '<br>backward에서 ', tex('\\partial/\\partial q = z'), ', ', tex('\\partial/\\partial z = q'), ' 를 그대로 씁니다.',
        '</p>',
      ].join(''),
      phase: 'fwd', phaseLabel: 'Forward pass', activeGate: 'mul',
      fwdEdges: ['e1', 'e2', 'e3', 'e4', 'e5'], bwdEdges: [], flabels: ['e3', 'e4', 'e5'], blabels: [], llabels: [], badges: [],
      fVal: 'f = -12', fColor: 'fwd',
    },
    {
      title: 'Backward Pass 시작',
      body: () => [
        '<p>Gradient가 출력에서 입력 쪽으로 흐르기 시작합니다.</p>',
        '<p style="margin-top:10px">', tex('\\dfrac{\\partial f}{\\partial f} = 1'), '</p>',
        '<p style="margin-top:6px;color:var(--text-muted);font-size:12px">출력 자신에 대한 gradient는 항상 1입니다.</p>',
        '<p style="margin-top:8px;color:var(--text-muted);font-size:12px">점선 화살표 \u2192 gradient의 역방향 흐름</p>',
      ].join(''),
      phase: 'bwd', phaseLabel: 'Backward pass', activeGate: null,
      fwdEdges: ['e1', 'e2', 'e3', 'e4', 'e5'], bwdEdges: ['e5'], flabels: [], blabels: [], llabels: [], badges: ['f'],
      fVal: 'f = -12', fColor: 'fwd',
    },
    {
      title: 'Backward Pass \u2014 MUL 게이트',
      body: () => [
        '<p style="color:var(--text-muted);font-size:11.5px;margin-bottom:8px">chain rule: upstream gradient ', tex('\\times'), ' local gradient</p>',
        '<p>', texC('\\dfrac{\\partial f}{\\partial q} = \\underbrace{1}_{\\text{upstream}} \\cdot \\htmlClass{bp-local-part}{\\underbrace{z}_{\\text{local}}} = -4'), '</p>',
        '<p style="margin-top:6px">', texC('\\dfrac{\\partial f}{\\partial z} = \\underbrace{1}_{\\text{upstream}} \\cdot \\htmlClass{bp-local-part}{\\underbrace{q}_{\\text{local}}} = 3'), '</p>',
        '<p style="margin-top:10px;color:var(--text-muted);font-size:12px">각 입력의 gradient = 상대 입력값 ', tex('\\times'), ' upstream gradient</p>',
      ].join(''),
      phase: 'bwd', phaseLabel: 'Backward pass', activeGate: 'mul',
      fwdEdges: ['e1', 'e2', 'e3', 'e4', 'e5'], bwdEdges: ['e5', 'e3', 'e4'], flabels: [], blabels: ['e3', 'e4'], llabels: ['e3', 'e4'], badges: ['f', 'z'],
      fVal: 'f = -12', fColor: 'fwd',
    },
    {
      title: 'Backward Pass \u2014 ADD 게이트',
      body: () => [
        '<p style="color:var(--text-muted);font-size:11.5px;margin-bottom:8px">upstream grad ', tex('= -4'), ' 를 두 입력에 그대로 전달</p>',
        '<p>', texC('\\dfrac{\\partial f}{\\partial x} = \\underbrace{\\dfrac{\\partial f}{\\partial q}}_{\\text{upstream}=-4} \\cdot \\htmlClass{bp-local-part}{\\underbrace{\\dfrac{\\partial q}{\\partial x}}_{\\text{local}=1}} = -4'), '</p>',
        '<p style="margin-top:6px">', texC('\\dfrac{\\partial f}{\\partial y} = \\underbrace{\\dfrac{\\partial f}{\\partial q}}_{\\text{upstream}=-4} \\cdot \\htmlClass{bp-local-part}{\\underbrace{\\dfrac{\\partial q}{\\partial y}}_{\\text{local}=1}} = -4'), '</p>',
        '<p style="margin-top:10px;color:var(--text-muted);font-size:12px">ADD의 local gradient는 1입니다.</p>',
      ].join(''),
      phase: 'bwd', phaseLabel: 'Backward pass', activeGate: 'add',
      fwdEdges: ['e1', 'e2', 'e3', 'e4', 'e5'], bwdEdges: ['e5', 'e3', 'e4', 'e1', 'e2'], flabels: [], blabels: ['e3', 'e1', 'e2'], llabels: ['e1', 'e2'], badges: ['f', 'z', 'x', 'y'],
      fVal: 'f = -12', fColor: 'fwd',
    },
    {
      title: 'Backpropagation 완료',
      body: () => [
        '<p style="margin-bottom:10px">최종 gradient 요약:</p>',
        '<table>',
          '<tr><td style="width:55%;padding:2px 0">', tex('\\dfrac{\\partial f}{\\partial x} = -4'), '</td>',
               '<td style="font-size:11.5px;color:var(--text-muted)">x를 조금 늘리면 f는 그 4배만큼 감소</td></tr>',
          '<tr><td style="padding:2px 0">', tex('\\dfrac{\\partial f}{\\partial y} = -4'), '</td>',
               '<td style="font-size:11.5px;color:var(--text-muted)">y를 조금 늘리면 f는 그 4배만큼 감소</td></tr>',
          '<tr><td style="padding:2px 0">', tex('\\dfrac{\\partial f}{\\partial z} = 3'), '</td>',
               '<td style="font-size:11.5px;color:var(--text-muted)">z를 조금 늘리면 f는 그 3배만큼 증가</td></tr>',
        '</table>',
      ].join(''),
      phase: 'done', phaseLabel: '완료', activeGate: null,
      fwdEdges: ['e1', 'e2', 'e3', 'e4', 'e5'], bwdEdges: ['e5', 'e3', 'e4', 'e1', 'e2'],
      flabels: ['e1', 'e2', 'e3', 'e4', 'e5'], blabels: ['e3', 'e4', 'e1', 'e2'], llabels: [],
      badges: ['f', 'z', 'x', 'y'],
      fVal: 'f = -12', fColor: 'fwd',
    },
  ];

  const widget = document.querySelector('.bp-widget') as HTMLElement;
  const N = STEPS.length;
  // Horizontal center (viewBox units) of the part each step changes; used to
  // keep it in view when the circuit panel scrolls on narrow screens.
  const FOCUS_X = [85, 301, 520, 616, 461, 301, 360];
  const VIEWBOX_W = 720;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  function keepFocusInView(): void {
    const wrap = widget.querySelector('.bp-circuit-wrap') as HTMLElement;
    if (wrap.scrollWidth <= wrap.clientWidth) return;
    const svg = document.getElementById('bp-ckt')!;
    const x = (FOCUS_X[cur] / VIEWBOX_W) * svg.getBoundingClientRect().width;
    wrap.scrollTo({
      left: Math.max(0, x - wrap.clientWidth / 2),
      behavior: reduceMotion.matches ? 'auto' : 'smooth',
    });
  }
  const EIDS = ['e1', 'e2', 'e3', 'e4', 'e5'];
  let cur = 0;

  const phaseClass: Record<string, string> = {
    init: 'bp-ph-init', fwd: 'bp-ph-fwd', bwd: 'bp-ph-bwd', done: 'bp-ph-done',
  };


  function render(): void {
    const s = STEPS[cur];

    document.getElementById('bp-step-lbl')!.textContent = `${cur + 1} / ${N}`;

    const pg = document.getElementById('bp-prog')!;
    pg.innerHTML = '';
    for (let i = 0; i < N; i++) {
      const d = document.createElement('div');
      d.className = 'bp-seg' + (i < cur ? ' bp-seg-done' : i === cur ? ' bp-seg-active' : '');
      pg.appendChild(d);
    }

    const pt = document.getElementById('bp-phase-tag')!;
    pt.className = `bp-phase ${phaseClass[s.phase]}`;
    pt.textContent = s.phaseLabel;
    document.getElementById('bp-desc-title')!.textContent = s.title;
    document.getElementById('bp-desc-body')!.innerHTML = s.body();

    const showBwd = s.phase === 'bwd' || s.phase === 'done';
    widget.classList.toggle('is-bwd', showBwd);

    EIDS.forEach(id => {
      const p = document.getElementById(`bp-p${id}`);
      if (!p) return;
      const on = s.fwdEdges.includes(id);
      p.classList.toggle('is-on', on);
      p.setAttribute('marker-end', on ? 'url(#bp-ah-fwd)' : 'url(#bp-ah-off)');
      const pb = document.getElementById(`bp-p${id}b`);
      if (pb) pb.style.opacity = s.bwdEdges.includes(id) ? '1' : '0';
      const fl = document.getElementById(`bp-fl-${id}`);
      const bl = document.getElementById(`bp-bl-${id}`);
      if (fl) fl.style.opacity = s.flabels.includes(id) ? '1' : '0';
      if (bl) bl.style.opacity = s.blabels.includes(id) ? '1' : '0';
      const ll = document.getElementById(`bp-ll-${id}`);
      if (ll) ll.style.opacity = s.llabels.includes(id) ? '1' : '0';
    });

    ['x', 'y', 'z', 'f'].forEach(id => {
      const el = document.getElementById(`bp-badge-${id}`);
      if (el) el.style.opacity = s.badges.includes(id) ? '1' : '0';
    });

    const fv = document.getElementById('bp-val-f')!;
    fv.innerHTML = tex(s.fVal);
    fv.style.color = s.fColor === 'fwd' ? 'var(--bp-fwd)' : 'var(--bp-muted)';

    ['add', 'mul'].forEach(g => {
      const on = s.activeGate === g;
      const mode = s.phase === 'bwd' ? 'is-grad' : 'is-fwd';
      [document.getElementById(`bp-r-${g}`), document.getElementById(`bp-g-${g}`)].forEach(el => {
        if (!el) return;
        el.classList.remove('is-fwd', 'is-grad');
        if (on) el.classList.add(mode);
      });
    });

    // Gate cards
    ['add', 'mul'].forEach(g => {
      const el = document.getElementById(`bp-gc-${g}`)!;
      el.classList.toggle('bp-gc-lit', s.activeGate === g);
    });

    document.getElementById('bp-gr-add')!.innerHTML = showBwd ? gateBwd.ruleAdd : gateFwd.ruleAdd;
    document.getElementById('bp-gr-mul')!.innerHTML = showBwd ? gateBwd.ruleMul : gateFwd.ruleMul;
    ['add', 'mul'].forEach(g => {
      const key = g as 'add' | 'mul';
      document.getElementById(`bp-gf-${g}`)!.innerHTML = showBwd ? gateBwd[key] : gateFwd[key];
    });

    const prevBtn = document.getElementById('bp-btn-prev') as HTMLButtonElement;
    const nextBtn = document.getElementById('bp-btn-next') as HTMLButtonElement;
    prevBtn.disabled = cur === 0;
    nextBtn.disabled = cur === N - 1;
    nextBtn.textContent = cur === N - 1 ? '완료' : '다음 →';
  }

  function go(d: number): void {
    cur = Math.max(0, Math.min(N - 1, cur + d));
    render();
    keepFocusInView();
  }

  function rst(): void {
    cur = 0;
    render();
    keepFocusInView();
  }

  // Button handlers
  document.getElementById('bp-btn-prev')!.addEventListener('click', () => go(-1));
  document.getElementById('bp-btn-next')!.addEventListener('click', () => go(1));
  document.getElementById('bp-btn-reset')!.addEventListener('click', () => rst());

  // Keyboard navigation (scoped to widget focus)
  widget.setAttribute('tabindex', '0');
  widget.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'ArrowRight' || e.key === ' ') { e.preventDefault(); go(1); }
    if (e.key === 'ArrowLeft') { e.preventDefault(); go(-1); }
  });

  // Value labels: anchor a = t/b/c (vertical) + l/c (horizontal) at (x, y) in viewBox units.
  type Anchor = 'tc' | 'bc' | 'tl' | 'bl' | 'cc';
  const TRANSFORM: Record<Anchor, string> = {
    tc: 'translate(-50%,0)', bc: 'translate(-50%,-100%)', tl: 'none',
    bl: 'translate(0,-100%)', cc: 'translate(-50%,-50%)',
  };
  const VB_H = 260;
  const OVERLAYS: [string, string, string, number, number, Anchor][] = [
    // [id, class, tex, x, y, anchor]
    ['bp-nv-x', 'node', 'x = -2', 85, 62, 'cc'],
    ['bp-nv-y', 'node', 'y = 5', 85, 137, 'cc'],
    ['bp-nv-z', 'node', 'z = -4', 85, 212, 'cc'],
    ['bp-val-f', 'node', 'f = \\text{?}', 616, 164, 'cc'],
    ['bp-g-add', 'gate', '+', 301, 92, 'cc'],
    ['bp-g-mul', 'gate', '\\times', 461, 157, 'cc'],
    ['bp-fl-e1', 'fwd', '-2', 182, 59, 'tc'],
    ['bp-fl-e2', 'fwd', '5', 182, 126, 'bc'],
    ['bp-fl-e3', 'fwd', 'q = 3', 343, 96, 'tl'],
    ['bp-fl-e4', 'fwd', '-4', 250, 201, 'bc'],
    ['bp-fl-e5', 'fwd', '-12', 528, 161, 'tc'],
    ['bp-bl-e1', 'grad', '\\partial f/\\partial x = -4', 150, 45, 'bl'],
    ['bp-bl-e2', 'grad', '\\partial f/\\partial y = -4', 150, 141, 'tl'],
    ['bp-bl-e3', 'grad', '\\partial f/\\partial q = -4', 343, 82, 'bl'],
    ['bp-bl-e4', 'grad', '\\partial f/\\partial z = 3', 250, 215, 'tc'],
    ['bp-bl-e5', 'grad', '\\partial f/\\partial f = 1', 528, 135, 'bc'],
    ['bp-ll-e1', 'local', '\\partial q/\\partial x = 1', 248, 70, 'bl'],
    ['bp-ll-e2', 'local', '\\partial q/\\partial y = 1', 248, 114, 'tl'],
    ['bp-ll-e3', 'local', '\\partial f/\\partial q = z = -4', 400, 135, 'bl'],
    ['bp-ll-e4', 'local', '\\partial f/\\partial z = q = 3', 400, 180, 'tl'],
    ['bp-badge-x', 'grad', '\\partial f/\\partial x = -4', 85, 81, 'tc'],
    ['bp-badge-y', 'grad', '\\partial f/\\partial y = -4', 85, 156, 'tc'],
    ['bp-badge-z', 'grad', '\\partial f/\\partial z = 3', 85, 231, 'tc'],
    ['bp-badge-f', 'grad', '\\partial f/\\partial f = 1', 616, 181, 'tc'],
  ];
  const layer = document.getElementById('bp-lbl-layer')!;
  OVERLAYS.forEach(([id, kind, src, x, y, a]) => {
    const el = document.createElement('span');
    el.id = id;
    el.className = `bp-ol bp-ol-${kind}`;
    el.style.left = `${(x / VIEWBOX_W) * 100}%`;
    el.style.top = `${(y / VB_H) * 100}%`;
    el.style.transform = TRANSFORM[a];
    if (kind !== 'node' && kind !== 'gate') el.style.opacity = '0';
    el.innerHTML = tex(src);
    layer.appendChild(el);
  });

  // Render equation as KaTeX
  document.getElementById('bp-eq-overlay')!.innerHTML = tex('f(x,\\,y,\\,z) = (x + y) \\cdot z');

  // Initial render
  render();

  // Redraw on theme change
  const observer = new MutationObserver(() => render());
  observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
</script>
