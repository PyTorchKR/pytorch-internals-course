---
/**
 * TorchrunVisualizer.astro
 *
 * 8단계 torchrun two-node distributed training 시각화 위젯.
 * 사이트 루트의 data-theme="dark" attribute를 기준으로 자동으로 라이트/다크가 전환됩니다.
 *
 * 사용법:
 *   import TorchrunVisualizer from './TorchrunVisualizer.astro';
 *   <TorchrunVisualizer />
 */

// Ring all-reduce 경로. visible path와 animateMotion path 모두에 같은 string 재사용.
const ringPath = 'M 54 198 L 123 198 L 192 198 L 261 198 L 261 354 L 192 354 L 123 354 L 54 354 L 54 420 L 419 420 L 419 354 L 488 354 L 557 354 L 626 354 L 626 198 L 557 198 L 488 198 L 419 198 L 419 108 L 54 108 L 54 198';
---

<div class="trv-root">
  <div class="trv-stage-card">
    <div>
      <span class="trv-stage-num">스텝 1 / 8</span>
      <span class="trv-stage-title"></span>
    </div>
    <div class="trv-stage-desc"></div>
  </div>

  <div class="trv-diagram show-command">
    <svg width="100%" viewBox="0 0 680 484" role="img" aria-label="torchrun 2-node 8-stage lifecycle">
      <g class="trv-command-display">
        <rect x="10" y="6" width="295" height="68" rx="6"
              fill="var(--bg-surface)"
              stroke="var(--border)" stroke-width="0.5"/>
        <text x="20" y="18" font-family="var(--fig-font-mono)" font-size="10" fill="var(--text-muted)">user@<tspan fill="var(--text)" font-weight="500">node-0</tspan> $ torchrun \</text>
        <text x="20" y="30" font-family="var(--fig-font-mono)" font-size="10" fill="var(--text)">    --nnodes=2 --nproc-per-node=8 \</text>
        <text x="20" y="42" font-family="var(--fig-font-mono)" font-size="10" fill="var(--text)">    --rdzv-id=job1 --rdzv-backend=c10d \</text>
        <text x="20" y="54" font-family="var(--fig-font-mono)" font-size="10" fill="var(--text)">    --rdzv-endpoint=192.168.0.2:29500 \</text>
        <text x="20" y="66" font-family="var(--fig-font-mono)" font-size="10" fill="var(--text)">    dist_matmul_allreduce.py</text>

        <rect x="375" y="6" width="295" height="68" rx="6"
              fill="var(--bg-surface)"
              stroke="var(--border)" stroke-width="0.5"/>
        <text x="385" y="18" font-family="var(--fig-font-mono)" font-size="10" fill="var(--text-muted)">user@<tspan fill="var(--text)" font-weight="500">node-1</tspan> $ torchrun \</text>
        <text x="385" y="30" font-family="var(--fig-font-mono)" font-size="10" fill="var(--text)">    --nnodes=2 --nproc-per-node=8 \</text>
        <text x="385" y="42" font-family="var(--fig-font-mono)" font-size="10" fill="var(--text)">    --rdzv-id=job1 --rdzv-backend=c10d \</text>
        <text x="385" y="54" font-family="var(--fig-font-mono)" font-size="10" fill="var(--text)">    --rdzv-endpoint=192.168.0.2:29500 \</text>
        <text x="385" y="66" font-family="var(--fig-font-mono)" font-size="10" fill="var(--text)">    dist_matmul_allreduce.py</text>
      </g>

      <g class="trv-rdzv-coord">
        <rect class="trv-rdzv-rect" x="270" y="18" width="140" height="42" rx="8"
              fill="var(--trv-coord-bg)"
              stroke="var(--trv-info)" stroke-width="1"/>
        <text x="340" y="36" text-anchor="middle" font-size="11" font-weight="500" fill="var(--trv-info)">Rendezvous · TCPStore</text>
        <text x="340" y="52" text-anchor="middle" font-size="10" font-family="var(--fig-font-mono)" fill="var(--text-muted)">:29500 · WORLD=16</text>
      </g>

      <g>
        <rect x="10" y="102" width="295" height="306" rx="14"
              fill="var(--trv-node-bg)"
              stroke="var(--border)" stroke-width="1"
              stroke-dasharray="4 3"/>
        <text x="157" y="124" text-anchor="middle" font-size="14" font-weight="500" fill="var(--text)">Node 0 · 192.168.0.2</text>
        <text x="157" y="140" text-anchor="middle" font-size="12" fill="var(--text-muted)">group rank: rendezvous가 결정 (예: 0)</text>
      </g>

      <g>
        <rect x="375" y="102" width="295" height="306" rx="14"
              fill="var(--trv-node-bg)"
              stroke="var(--border)" stroke-width="1"
              stroke-dasharray="4 3"/>
        <text x="522" y="124" text-anchor="middle" font-size="14" font-weight="500" fill="var(--text)">Node 1 · 192.168.0.3</text>
        <text x="522" y="140" text-anchor="middle" font-size="12" fill="var(--text-muted)">group rank: rendezvous가 결정 (예: 1)</text>
      </g>

      <!-- Rendezvous lines sit above Node containers (so they're visible)
           but below GPU boxes (so they appear to terminate at each GPU). -->
      <g class="trv-agent-lines">
        <path class="trv-agent-line" fill="none" d="M 157 102 V 81 H 320 V 60" stroke="var(--trv-info)" stroke-width="1" stroke-dasharray="3 3"/>
        <path class="trv-agent-line" fill="none" d="M 522 102 V 81 H 360 V 60" stroke="var(--trv-info)" stroke-width="1" stroke-dasharray="3 3"/>
        <text x="163" y="95" font-size="10" fill="var(--trv-info)">agent</text>
        <text x="516" y="95" font-size="10" text-anchor="end" fill="var(--trv-info)">agent</text>
      </g>
      <g class="trv-rdzv-lines"></g>

      <g class="trv-compute-glows"></g>
      <g class="trv-processes"></g>
      <g class="trv-data-badges"></g>

      <g class="trv-ring-elements">
        <path d={ringPath}
              fill="none" stroke="var(--trv-amber)" stroke-width="1.2" opacity="0.3" stroke-dasharray="3 3"/>
        <circle r="4.5" fill="var(--trv-amber)">
          <animateMotion dur="9s" repeatCount="indefinite" begin="0s" path={ringPath}/>
        </circle>
        <circle r="4.5" fill="var(--trv-amber)">
          <animateMotion dur="9s" repeatCount="indefinite" begin="-2.25s" path={ringPath}/>
        </circle>
        <circle r="4.5" fill="var(--trv-amber)">
          <animateMotion dur="9s" repeatCount="indefinite" begin="-4.5s" path={ringPath}/>
        </circle>
        <circle r="4.5" fill="var(--trv-amber)">
          <animateMotion dur="9s" repeatCount="indefinite" begin="-6.75s" path={ringPath}/>
        </circle>
      </g>

      <g class="trv-pg-coord">
        <rect class="trv-pg-rect" x="284" y="254" width="112" height="44" rx="8"
              fill="var(--trv-coord-bg)"
              stroke="var(--trv-amber)" stroke-width="1"/>
        <text x="340" y="272" text-anchor="middle" font-size="11" font-weight="500" fill="var(--trv-amber)">Process Group</text>
        <text x="340" y="288" text-anchor="middle" font-size="10" font-family="var(--fig-font-mono)" fill="var(--text-muted)">backend = nccl</text>
      </g>

      <g class="trv-cleanup-label">
        <rect x="244" y="254" width="192" height="44" rx="8"
              fill="var(--trv-coord-bg)"
              stroke="var(--text-muted)" stroke-width="0.5"/>
        <text x="340" y="272" text-anchor="middle" font-size="11" font-weight="500" fill="var(--text-muted)">destroy_process_group()</text>
        <text x="340" y="288" text-anchor="middle" font-size="10" fill="var(--text-muted)" opacity="0.7">통신 그룹 해제</text>
      </g>
    </svg>
  </div>

  <div class="trv-controls">
    <button class="fig-btn trv-btn-prev" type="button" aria-label="이전"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15.41 7.41 14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg><span>이전</span></button>
    <button class="fig-btn trv-btn-play" type="button" aria-label="재생"><svg class="trv-icon-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg><svg class="trv-icon-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 4h4v16H6zm8 0h4v16h-4z"/></svg><span class="trv-play-label">재생</span></button>
    <button class="fig-btn trv-btn-next" type="button" aria-label="다음"><span>다음</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8.59 16.59 10 18l6-6-6-6-1.41 1.41L13.17 12z"/></svg></button>
    <div class="trv-progress"></div>
    <button class="fig-btn trv-btn-reset" type="button" aria-label="처음으로"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.65 6.35A7.96 7.96 0 0 0 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0 1 12 18c-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"/></svg></button>
  </div>
</div>

<style>
  .trv-root {
    --trv-info: var(--fig-blue-ink);
    --trv-info-text: var(--fig-surface);
    --trv-amber: var(--fig-amber);

    --trv-coord-bg: var(--fig-surface);
    --trv-node-bg: color-mix(in srgb, var(--fig-fill) 60%, var(--fig-surface));

    --trv-node0-fill: var(--fig-blue-tint);
    --trv-node0-stroke: var(--fig-blue-ink);
    --trv-node0-pill-bg: color-mix(in srgb, var(--fig-blue) 30%, var(--fig-surface));
    --trv-node0-pill-text: var(--fig-blue-ink);

    --trv-node1-fill: var(--fig-purple-tint);
    --trv-node1-stroke: var(--fig-purple);
    --trv-node1-pill-bg: color-mix(in srgb, var(--fig-purple) 30%, var(--fig-surface));
    --trv-node1-pill-text: var(--fig-purple-ink);

    color: var(--text);
    line-height: 1.5;
    max-width: 720px;
    margin: 0 auto;
  }

  /* ── Stage card ──────────────────────────────────────────────── */
  .trv-stage-card {
    padding: 14px 16px;
    background: var(--bg-surface);
    border-radius: 8px;
    margin-bottom: 14px;
    min-height: 110px;
  }

  .trv-stage-num {
    display: inline-block;
    background: var(--trv-info);
    color: var(--trv-info-text);
    font-size: 11px;
    padding: 2px 10px;
    border-radius: 10px;
    margin-right: 10px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  .trv-stage-title {
    font-weight: 500;
    font-size: 15px;
    color: var(--text);
  }

  .trv-stage-desc {
    font-size: 13px;
    color: var(--text-muted);
    margin-top: 8px;
    line-height: 1.65;
  }

  /* ── Controls ────────────────────────────────────────────────── */
  .trv-controls {
    display: flex;
    gap: 8px;
    align-items: center;
    margin-top: 14px;
    flex-wrap: wrap;
  }

  .trv-btn-play { min-width: 104px; justify-content: center; }
  .trv-icon-pause { display: none; }
  .trv-btn-play.is-playing .trv-icon-play { display: none; }
  .trv-btn-play.is-playing .trv-icon-pause { display: inline-block; }
  .trv-btn-reset { flex-shrink: 0; }

  .trv-progress {
    flex: 1;
    display: flex;
    gap: 4px;
    padding: 0 8px;
    min-width: 120px;
  }

  .trv-progress-pip {
    flex: 1;
    height: 4px;
    background: var(--border);
    border-radius: 2px;
    transition: background 0.3s;
    cursor: pointer;
  }
  .trv-progress-pip.active { background: var(--trv-info); }
  .trv-progress-pip.done { background: var(--trv-info); opacity: 0.45; }

  /* ── Stage-driven SVG visibility ─────────────────────────────── */
  /* `:global()` is required for the script-inserted SVG children
     (.trv-proc-box, .trv-rdzv-line, .trv-data-badge, .trv-compute-glow,
     .trv-rank-pill) — they don't carry Astro's data-astro-cid attribute,
     so unscoped selectors are needed for the rules to apply. */
  :global(.trv-proc-box) { opacity: 0; transition: opacity 0.45s ease; }
  .trv-diagram.spawned :global(.trv-proc-box) { opacity: 1; }

  :global(.trv-rank-pill) { opacity: 0; transition: opacity 0.5s ease; }
  .trv-diagram.ranks-shown :global(.trv-rank-pill) { opacity: 1; }

  .trv-rdzv-coord { opacity: 0; transition: opacity 0.5s ease; }
  .trv-diagram.rdzv-agents .trv-rdzv-coord { opacity: 1; }
  .trv-agent-lines { opacity: 0; transition: opacity 0.6s ease; }
  .trv-diagram.rdzv-agents .trv-agent-lines { opacity: 0.8; }
  .trv-diagram.cleanup .trv-agent-lines { opacity: 0.3; }
  .trv-diagram.cleanup .trv-rdzv-coord { opacity: 0.35; }

  /* "Just appeared" flash for the Rendezvous box at stage 3.
     Brief peak then settles into a held, slightly-emphasized state. */
  .trv-diagram.rdzv-flash .trv-rdzv-rect {
    animation: trv-rdzv-flash 0.9s ease-out forwards;
  }
  @keyframes trv-rdzv-flash {
    0%   { stroke-width: 1; filter: none; }
    35%  { stroke-width: 2.4; filter: drop-shadow(0 0 8px var(--trv-info)); }
    100% { stroke-width: 1.4; filter: drop-shadow(0 0 3px var(--trv-info)); }
  }

  :global(.trv-rdzv-line) { opacity: 0; transition: opacity 0.6s ease; }
  .trv-diagram.rdzv :global(.trv-rdzv-line) { opacity: 0.7; }

  .trv-pg-coord { opacity: 0; transition: opacity 0.5s ease; }
  .trv-diagram.init-group .trv-pg-coord { opacity: 1; }

  /* "Just appeared" flash for the Process Group at stage 4.
     The held state persists through stages 5-6, until stage 7's pulse
     overrides it (see below). */
  .trv-diagram.init-group .trv-pg-rect {
    animation: trv-pg-flash 0.9s ease-out forwards;
  }
  @keyframes trv-pg-flash {
    0%   { stroke-width: 1; filter: none; }
    35%  { stroke-width: 2.4; filter: drop-shadow(0 0 8px var(--trv-amber)); }
    100% { stroke-width: 1.4; filter: drop-shadow(0 0 3px var(--trv-amber)); }
  }

  /* During all-reduce, emphasize that the collective is dispatched
     through the Process Group (c10d::ProcessGroupNCCL). Continuous
     pulse overrides the held flash from stage 4. */
  .trv-diagram.all-reduce .trv-pg-rect {
    animation: trv-pg-pulse 1.6s ease-in-out infinite;
  }
  @keyframes trv-pg-pulse {
    0%, 100% { stroke-width: 1.4; filter: drop-shadow(0 0 3px var(--trv-amber)); }
    50%      { stroke-width: 2.4; filter: drop-shadow(0 0 8px var(--trv-amber)); }
  }

  .trv-command-display { opacity: 0; transition: opacity 0.4s ease; }
  .trv-diagram.show-command .trv-command-display { opacity: 1; }

  :global(.trv-data-badge) { opacity: 0; transition: opacity 0.5s ease; }
  .trv-diagram.sharding :global(.trv-data-badge) { opacity: 1; }

  :global(.trv-compute-glow) { opacity: 0; }
  .trv-diagram.computing :global(.trv-compute-glow) {
    animation: trv-glow-pulse 1.4s ease-in-out infinite;
  }
  @keyframes trv-glow-pulse {
    0%, 100% { opacity: 0; }
    50% { opacity: 0.35; }
  }

  .trv-ring-elements { opacity: 0; transition: opacity 0.4s ease; }
  .trv-diagram.all-reduce .trv-ring-elements { opacity: 1; }

  .trv-cleanup-label { opacity: 0; transition: opacity 0.4s ease; }
  .trv-diagram.cleanup .trv-cleanup-label { opacity: 1; }
  .trv-diagram.cleanup :global(.trv-proc-box) { opacity: 0.35; }
  .trv-diagram.cleanup :global(.trv-rank-pill) { opacity: 0.2; }
  .trv-diagram.cleanup :global(.trv-data-badge) { opacity: 0; }
</style>

<script>
  const stages = [
    {
      title: '1. torchrun 명령어 실행',
      desc: '두 노드에서 완전히 같은 명령을 실행합니다. --node-rank 같은 노드 번호는 주지 않습니다. 어느 노드가 몇 번인지는 다음 단계의 rendezvous가 정합니다. 두 노드 모두 --rdzv-backend=c10d를 주며, 이 옵션이 없으면 torchrun은 static backend를 쓰고 이때는 --node-rank가 필요합니다.',
      classes: ['show-command'],
    },
    {
      title: '2. Agent rendezvous',
      desc: '각 노드의 torchrun agent가 192.168.0.2:29500의 TCPStore에 모여 참여 노드를 확정합니다. 노드 순서(group rank), WORLD_SIZE=16, 각 worker의 RANK, MASTER_ADDR/MASTER_PORT가 여기서 정해집니다. worker process는 아직 없습니다.',
      classes: ['rdzv-agents', 'rdzv-flash'],
    },
    {
      title: '3. Worker spawn + 환경변수 설정',
      desc: 'agent가 --nproc-per-node=8만큼 worker process를 띄우면서 RANK, LOCAL_RANK, WORLD_SIZE, MASTER_ADDR, MASTER_PORT를 환경변수로 넣어 줍니다. worker는 이 환경변수에서 자기 rank를 읽습니다.',
      classes: ['rdzv-agents', 'spawned', 'ranks-shown'],
    },
    {
      title: '4. Process group 초기화 (backend 선택)',
      desc: "init_process_group(backend='nccl')이 환경변수(env://)를 읽고, agent가 열어 둔 TCPStore에 client로 접속해 NCCL process group을 만듭니다. GPU 학습이면 NCCL, CPU면 Gloo를 보통 씁니다.",
      classes: ['rdzv-agents', 'spawned', 'ranks-shown', 'rdzv', 'init-group'],
    },
    {
      title: '5. 입력 broadcast + 조각 선택',
      desc: 'rank 0이 가진 A, B를 broadcast로 모든 worker에 보내고, 각 worker는 global RANK 기준으로 자기 조각(A의 열, B의 행)을 고릅니다. worker마다 다른 조각을 갖습니다.',
      classes: ['rdzv-agents', 'spawned', 'ranks-shown', 'init-group', 'sharding'],
    },
    {
      title: '6. Local matmul',
      desc: '각 worker가 자기 조각으로 local_A @ local_B를 계산합니다. 조각이 다르므로 16개 결과도 서로 다릅니다.',
      classes: ['rdzv-agents', 'spawned', 'ranks-shown', 'init-group', 'sharding', 'computing'],
    },
    {
      title: '7. Ring all-reduce 합산',
      desc: 'dist.all_reduce(local_result, SUM) 호출이 process group(c10d::ProcessGroupNCCL)을 통해 NCCL backend로 내려가고, NCCL이 토폴로지에 맞춰 알고리즘(ring, tree 등)을 고릅니다. 그림은 ring인 경우로, 부분합을 옆 worker에게 넘기며 더해 갑니다. 끝나면 모든 worker가 전체 곱 AB를 갖습니다.',
      classes: ['rdzv-agents', 'spawned', 'ranks-shown', 'init-group', 'sharding', 'all-reduce'],
    },
    {
      title: '8. Process group 제거',
      desc: 'destroy_process_group()으로 process group이 해제되고 worker가 종료되면 agent도 종료합니다. --max-restarts=N 옵션이면 worker 실패 시 새 rendezvous를 거쳐 N번까지 재시작을 시도합니다.',
      classes: ['rdzv-agents', 'spawned', 'ranks-shown', 'cleanup'],
    },
  ];

  function initWidget(root: HTMLElement) {
    if (root.dataset.trvInit === '1') return;
    root.dataset.trvInit = '1';

    const diagram = root.querySelector('.trv-diagram') as HTMLElement;
    const stageNum = root.querySelector('.trv-stage-num') as HTMLElement;
    const stageTitle = root.querySelector('.trv-stage-title') as HTMLElement;
    const stageDesc = root.querySelector('.trv-stage-desc') as HTMLElement;
    const btnPrev = root.querySelector('.trv-btn-prev') as HTMLButtonElement;
    const btnPlay = root.querySelector('.trv-btn-play') as HTMLButtonElement;
    const btnNext = root.querySelector('.trv-btn-next') as HTMLButtonElement;
    const btnReset = root.querySelector('.trv-btn-reset') as HTMLButtonElement;
    const progress = root.querySelector('.trv-progress') as HTMLElement;
    const procs = root.querySelector('.trv-processes') as SVGGElement;
    const lines = root.querySelector('.trv-rdzv-lines') as SVGGElement;
    const glows = root.querySelector('.trv-compute-glows') as SVGGElement;
    const badges = root.querySelector('.trv-data-badges') as SVGGElement;

    let currentStage = 0;
    let isPlaying = false;
    let playTimer: number | null = null;

    // Orthogonal rendezvous routing (all coordinates in SVG units):
    //   GPU top -> row bus -> (row 1 only: one riser at the column-gap centre) ->
    //   row-0 bus -> central trunk in the gap between the nodes -> coordinator box.
    const rdzvX = 340;
    const rdzvY = 58;
    const busY0 = 156; // 12 below the node header text, 12 above the GPU row-0 tops
    const busY1 = 276; // centre of the gap between the two GPU rows
    const colXNode0 = [26, 95, 164, 233];
    const colXNode1 = [391, 460, 529, 598];
    const rowY = [168, 324];
    const rdzvPath = (d: string) =>
      '<path class="trv-rdzv-line" fill="none" d="' + d +
      '" stroke="var(--trv-info)" stroke-width="0.8" stroke-dasharray="3 3"/>';

    let procSVG = '';
    let lineSVG = '';
    let glowSVG = '';
    let badgeSVG = '';

    for (let nodeIdx = 0; nodeIdx < 2; nodeIdx++) {
      const colX = nodeIdx === 0 ? colXNode0 : colXNode1;
      const fillVar = nodeIdx === 0 ? 'var(--trv-node0-fill)' : 'var(--trv-node1-fill)';
      const strokeVar = nodeIdx === 0 ? 'var(--trv-node0-stroke)' : 'var(--trv-node1-stroke)';
      const pillBgVar = nodeIdx === 0 ? 'var(--trv-node0-pill-bg)' : 'var(--trv-node1-pill-bg)';
      const pillTextVar = nodeIdx === 0 ? 'var(--trv-node0-pill-text)' : 'var(--trv-node1-pill-text)';

      for (let local = 0; local < 8; local++) {
        const col = local % 4;
        const rowI = Math.floor(local / 4);
        const x = colX[col];
        const y = rowY[rowI];
        const cx = x + 28;
        const cy = y + 30;
        const globalRank = nodeIdx * 8 + local;
        const delay = (globalRank * 0.04).toFixed(2);

        glowSVG +=
          '<rect class="trv-compute-glow" x="' + (x - 3) + '" y="' + (y - 3) +
          '" width="62" height="66" rx="9" fill="var(--fig-amber)"/>';

        procSVG +=
          '<g class="trv-proc-box" style="transition-delay:' + delay + 's">' +
            '<rect x="' + x + '" y="' + y + '" width="56" height="60" rx="6" ' +
              'fill="' + fillVar + '" stroke="' + strokeVar + '" stroke-width="0.3"/>' +
            '<text font-size="12" x="' + cx + '" y="' + (y + 22) +
              '" text-anchor="middle" font-weight="500" fill="var(--text)">GPU ' + local + '</text>' +
            '<g class="trv-rank-pill">' +
              '<rect x="' + (x + 4) + '" y="' + (y + 36) + '" width="48" height="16" rx="8" ' +
                'fill="' + pillBgVar + '" opacity="0.6"/>' +
              '<text x="' + cx + '" y="' + (y + 47) +
                '" text-anchor="middle" font-size="10" font-weight="500" fill="' + pillTextVar + '">rank ' + globalRank + '</text>' +
            '</g>' +
          '</g>';

        badgeSVG +=
          '<rect class="trv-data-badge" x="' + (x + 8) + '" y="' + (y + 5) +
          '" width="40" height="3" rx="1.5" fill="var(--fig-teal)"/>';

        // GPU top up to its row bus.
        lineSVG += rdzvPath('M ' + cx + ' ' + y + ' V ' + (rowI === 0 ? busY0 : busY1));
      }

      // Row-1 bus joined to the row-0 bus by one riser centred in the GPU 1/2 column gap.
      const cxs = colX.map((c) => c + 28);
      const riserX = (cxs[1] + cxs[2]) / 2;
      lineSVG += rdzvPath('M ' + cxs[0] + ' ' + busY1 + ' H ' + cxs[3]);
      lineSVG += rdzvPath('M ' + riserX + ' ' + busY1 + ' V ' + busY0);
      // Row-0 bus runs out to the central trunk in the gap between the nodes.
      lineSVG += rdzvPath('M ' + (nodeIdx === 0 ? cxs[0] : cxs[3]) + ' ' + busY0 + ' H ' + rdzvX);
    }
    lineSVG += rdzvPath('M ' + rdzvX + ' ' + busY0 + ' V ' + rdzvY);

    glows.innerHTML = glowSVG;
    procs.innerHTML = procSVG;
    lines.innerHTML = lineSVG;
    badges.innerHTML = badgeSVG;

    for (let i = 0; i < stages.length; i++) {
      const pip = document.createElement('div');
      pip.className = 'trv-progress-pip';
      pip.addEventListener('click', ((idx: number) => () => {
        stopPlay();
        applyStage(idx);
      })(i));
      progress.appendChild(pip);
    }

    function applyStage(idx: number) {
      currentStage = idx;
      const stage = stages[idx];
      stageNum.textContent = '스텝 ' + (idx + 1) + ' / ' + stages.length;
      stageTitle.textContent = stage.title;
      stageDesc.textContent = stage.desc;

      diagram.className = 'trv-diagram ' + (stage.classes || []).join(' ');

      const pips = progress.querySelectorAll('.trv-progress-pip');
      pips.forEach((pip, i) => {
        pip.className = 'trv-progress-pip' + (i === idx ? ' active' : (i < idx ? ' done' : ''));
      });

      btnPrev.disabled = idx === 0;
      btnNext.disabled = idx === stages.length - 1;
    }

    const playLabel = btnPlay.querySelector('.trv-play-label') as HTMLElement;
    function setPlayUI(on: boolean) {
      btnPlay.classList.toggle('is-playing', on);
      playLabel.textContent = on ? '일시정지' : '재생';
      btnPlay.setAttribute('aria-label', on ? '일시정지' : '재생');
    }

    function goPrev() { if (currentStage > 0) { stopPlay(); applyStage(currentStage - 1); } }
    function goNext() { if (currentStage < stages.length - 1) { applyStage(currentStage + 1); } }
    function togglePlay() { if (isPlaying) stopPlay(); else startPlay(); }
    function startPlay() {
      if (currentStage === stages.length - 1) applyStage(0);
      isPlaying = true;
      setPlayUI(true);
      scheduleNext();
    }
    function scheduleNext() {
      playTimer = window.setTimeout(() => {
        if (currentStage < stages.length - 1) {
          applyStage(currentStage + 1);
          scheduleNext();
        } else {
          stopPlay();
        }
      }, 4000);
    }
    function stopPlay() {
      isPlaying = false;
      if (playTimer !== null) clearTimeout(playTimer);
      setPlayUI(false);
    }
    function resetAnim() { stopPlay(); applyStage(0); }

    btnPrev.addEventListener('click', goPrev);
    btnNext.addEventListener('click', goNext);
    btnPlay.addEventListener('click', togglePlay);
    btnReset.addEventListener('click', resetAnim);

    applyStage(0);
  }

  function bootstrap() {
    document.querySelectorAll<HTMLElement>('.trv-root').forEach(initWidget);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bootstrap);
  } else {
    bootstrap();
  }
</script>
