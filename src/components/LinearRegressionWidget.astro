---
/**
 * Interactive linear regression gradient descent visualization.
 * Supports dark/light mode via data-theme attribute.
 */
---

<div class="lr-widget">
  <p class="lr-equation" id="lr-equation">
    f(x) = 0.100x + 0.950
  </p>

  <canvas id="lr-canvas"></canvas>

  <div class="lr-stats" id="lr-stats">
    <div class="lr-stat">
      <span class="lr-stat-label">iteration</span>
      <span class="lr-stat-value" id="lr-iter">0</span>
    </div>
    <div class="lr-stat">
      <span class="lr-stat-label">loss (MSE)</span>
      <span class="lr-stat-value" id="lr-loss">0.00000</span>
    </div>
    <div class="lr-stat">
      <span class="lr-stat-label">slope a</span>
      <span class="lr-stat-value" id="lr-a">0.100</span>
    </div>
    <div class="lr-stat">
      <span class="lr-stat-label">intercept b</span>
      <span class="lr-stat-value" id="lr-b">0.950</span>
    </div>
  </div>

  <div class="lr-controls">
    <button id="lr-step" class="fig-btn" type="button">한 스텝</button>
    <button id="lr-play" class="fig-btn lr-btn-play" type="button" aria-label="재생"><svg class="lr-icon-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg><svg class="lr-icon-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 4h4v16H6zm8 0h4v16h-4z"/></svg><span class="lr-play-label">재생</span></button>
    <button id="lr-reset" class="fig-btn" type="button" aria-label="처음으로"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.65 6.35A7.96 7.96 0 0 0 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0 1 12 18c-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"/></svg></button>
    <button id="lr-toggle-err" class="fig-btn lr-btn-err" type="button">오차 숨기기</button>
    <div class="lr-speed">
      <span class="lr-speed-label">speed</span>
      <input type="range" id="lr-speed" min="1" max="8" value="1" step="1" />
      <span class="lr-speed-value" id="lr-speed-val">1</span>
    </div>
  </div>
</div>

<style>
  .lr-widget {
    padding: 0.75rem 0 0;
    max-width: 540px;
    margin: 0 auto;
  }
  .lr-equation {
    text-align: center;
    font-size: 17px;
    font-weight: 500;
    font-family: var(--fig-font-mono);
    color: var(--fig-purple);
    margin: 0 0 0.75rem;
    transition: color 0.4s;
  }
  .lr-equation.converged {
    color: var(--fig-teal-ink);
  }
  #lr-canvas {
    width: 100%;
    display: block;
    max-width: 520px;
    margin: 0 auto;
  }
  .lr-stats {
    display: flex;
    gap: 10px;
    max-width: 520px;
    margin: 12px auto 0;
  }
  .lr-stat {
    background: var(--bg-surface);
    border-radius: 8px;
    padding: 10px 16px;
    flex: 1;
    min-width: 0;
  }
  .lr-stat-label {
    display: block;
    font-size: 11px;
    color: var(--text-muted);
    margin-bottom: 3px;
  }
  .lr-stat-value {
    display: block;
    font-size: 20px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    color: var(--text);
  }
  .lr-controls {
    display: flex;
    align-items: center;
    gap: 8px;
    max-width: 520px;
    margin: 10px auto 0;
    flex-wrap: wrap;
  }
  .lr-btn-play { min-width: 104px; justify-content: center; }
  .lr-btn-err { min-width: 100px; justify-content: center; }
  .lr-icon-pause { display: none; }
  .lr-btn-play.is-playing .lr-icon-play { display: none; }
  .lr-btn-play.is-playing .lr-icon-pause { display: inline-block; }
  .lr-speed {
    flex: 1;
    min-width: 80px;
    display: flex;
    align-items: center;
    gap: 8px;
    margin-left: 4px;
  }
  .lr-speed-label,
  .lr-speed-value {
    font-size: 12px;
    color: var(--text-muted);
  }
  .lr-speed-value {
    min-width: 16px;
  }
  .lr-speed input[type='range'] {
    flex: 1;
  }
</style>

<script>
  const DATA: [number, number][] = [
    [0.08, 0.31], [0.15, 0.20], [0.22, 0.42], [0.30, 0.44],
    [0.38, 0.50], [0.46, 0.55], [0.54, 0.61], [0.62, 0.67],
    [0.70, 0.66], [0.77, 0.74], [0.85, 0.81], [0.93, 0.88],
  ];

  const LR = 0.38;
  const A0 = 0.10;
  const B0 = 0.95;
  const PAD = { l: 44, r: 16, t: 16, b: 34 };
  const CANVAS_H = 300;

  const canvas = document.getElementById('lr-canvas') as HTMLCanvasElement;
  const eqEl = document.getElementById('lr-equation')!;
  const iterEl = document.getElementById('lr-iter')!;
  const lossEl = document.getElementById('lr-loss')!;
  const aEl = document.getElementById('lr-a')!;
  const bEl = document.getElementById('lr-b')!;
  const stepBtn = document.getElementById('lr-step') as HTMLButtonElement;
  const playBtn = document.getElementById('lr-play') as HTMLButtonElement;
  const resetBtn = document.getElementById('lr-reset') as HTMLButtonElement;
  const toggleErrBtn = document.getElementById('lr-toggle-err') as HTMLButtonElement;
  const speedSlider = document.getElementById('lr-speed') as HTMLInputElement;
  const speedVal = document.getElementById('lr-speed-val')!;

  let a = A0, b = B0, iter = 0;
  let playing = false;
  let showErr = true;
  let spf = 1;
  let raf: number | null = null;

  function isDark(): boolean {
    return document.documentElement.getAttribute('data-theme') === 'dark';
  }

  function computeLoss(a: number, b: number): number {
    return DATA.reduce((s, [x, y]) => s + (a * x + b - y) ** 2, 0) / DATA.length;
  }

  function colors() {
    const cs = getComputedStyle(document.documentElement);
    const v = (name: string) => cs.getPropertyValue(name).trim();
    return {
      dot:      v('--fig-text-2'),
      dotRing:  v('--fig-surface'),
      dotHi:    'rgba(255,255,255,0.3)', // no token: specular highlight on the dot
      line:     v('--fig-purple'),
      lineDone: v('--fig-teal-ink'),
      err:      v('--fig-coral'),
      grid:     v('--fig-line-soft'),
      axis:     v('--fig-line'),
      tick:     v('--fig-text-2'),
      font:     getComputedStyle(canvas).fontFamily,
    };
  }

  function draw() {
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const W = canvas.offsetWidth;
    const H = CANVAS_H;
    const dpr = window.devicePixelRatio || 1;
    canvas.width = W * dpr;
    canvas.height = H * dpr;
    canvas.style.height = `${H}px`;
    ctx.scale(dpr, dpr);

    const C = colors();
    const px = (x: number) => PAD.l + x * (W - PAD.l - PAD.r);
    const py = (y: number) => PAD.t + (H - PAD.t - PAD.b) * (1 - y / 1.05);

    ctx.clearRect(0, 0, W, H);

    // Grid
    ctx.globalAlpha = 0.5; ctx.strokeStyle = C.grid; ctx.lineWidth = 0.5;
    for (let i = 1; i <= 5; i++) {
      ctx.beginPath(); ctx.moveTo(PAD.l, py(i * 0.2)); ctx.lineTo(W - PAD.r, py(i * 0.2)); ctx.stroke();
    }
    for (let i = 1; i <= 4; i++) {
      ctx.beginPath(); ctx.moveTo(px(i * 0.25), PAD.t); ctx.lineTo(px(i * 0.25), H - PAD.b); ctx.stroke();
    }

    ctx.globalAlpha = 1;

    // Axes
    ctx.strokeStyle = C.axis; ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(PAD.l, PAD.t); ctx.lineTo(PAD.l, H - PAD.b); ctx.lineTo(W - PAD.r, H - PAD.b); ctx.stroke();

    // Tick labels
    ctx.fillStyle = C.tick; ctx.font = '11px ' + C.font;
    ctx.textAlign = 'right';
    for (let i = 0; i <= 5; i++) ctx.fillText((i * 0.2).toFixed(1), PAD.l - 5, py(i * 0.2) + 4);
    ctx.textAlign = 'center';
    for (let i = 1; i <= 4; i++) ctx.fillText((i * 0.25).toFixed(2), px(i * 0.25), H - PAD.b + 14);

    ctx.save();
    ctx.beginPath(); ctx.rect(PAD.l, PAD.t, W - PAD.l - PAD.r, H - PAD.t - PAD.b); ctx.clip();

    const loss = computeLoss(a, b);
    const done = loss < 0.003;

    // Error lines
    if (showErr) {
      ctx.setLineDash([3, 4]); ctx.globalAlpha = 0.6; ctx.strokeStyle = C.err; ctx.lineWidth = 1;
      DATA.forEach(([x, y]) => {
        ctx.beginPath(); ctx.moveTo(px(x), py(y)); ctx.lineTo(px(x), py(a * x + b)); ctx.stroke();
      });
      ctx.setLineDash([]); ctx.globalAlpha = 1;
    }

    // Regression line
    ctx.strokeStyle = done ? C.lineDone : C.line; ctx.lineWidth = 2.2;
    ctx.beginPath(); ctx.moveTo(px(0), py(b)); ctx.lineTo(px(1), py(a + b)); ctx.stroke();

    // Data points
    DATA.forEach(([x, y]) => {
      const cx = px(x), cy = py(y);
      ctx.beginPath(); ctx.arc(cx, cy, 6.5, 0, Math.PI * 2);
      ctx.fillStyle = C.dot; ctx.fill();
      ctx.strokeStyle = C.dotRing; ctx.lineWidth = 1.5; ctx.stroke();
      ctx.beginPath(); ctx.arc(cx - 2.5, cy - 2.5, 2.5, 0, Math.PI * 2);
      ctx.fillStyle = C.dotHi; ctx.fill();
    });

    ctx.restore();

    // Update stats
    eqEl.textContent = `f(x) = ${a.toFixed(3)}x + ${b.toFixed(3)}`;
    eqEl.classList.toggle('converged', done);
    iterEl.textContent = String(iter);
    lossEl.textContent = loss.toFixed(5);
    aEl.textContent = a.toFixed(3);
    bEl.textContent = b.toFixed(3);
  }

  function stepOnce() {
    const n = DATA.length;
    let da = 0, db = 0;
    DATA.forEach(([x, y]) => { const e = a * x + b - y; da += e * x; db += e; });
    a -= LR * 2 / n * da;
    b -= LR * 2 / n * db;
    iter += 1;
  }

  const playLabel = playBtn.querySelector('.lr-play-label')!;
  function setPlayUI(isPlaying: boolean) {
    playBtn.classList.toggle('is-playing', isPlaying);
    playLabel.textContent = isPlaying ? '일시정지' : '재생';
    playBtn.setAttribute('aria-label', isPlaying ? '일시정지' : '재생');
  }

  function loop() {
    if (!playing) return;
    for (let i = 0; i < spf; i++) stepOnce();
    draw();
    if (iter >= 100) {
      playing = false;
      setPlayUI(false);
      stepBtn.disabled = false;
      return;
    }
    raf = window.setTimeout(() => requestAnimationFrame(loop), 60) as unknown as number;
  }

  stepBtn.addEventListener('click', () => {
    if (!playing) { stepOnce(); draw(); }
  });

  playBtn.addEventListener('click', () => {
    playing = !playing;
    setPlayUI(playing);
    stepBtn.disabled = playing;
    if (playing) loop();
    else if (raf !== null) clearTimeout(raf);
  });

  resetBtn.addEventListener('click', () => {
    playing = false;
    setPlayUI(false);
    stepBtn.disabled = false;
    if (raf !== null) clearTimeout(raf);
    a = A0; b = B0; iter = 0;
    draw();
  });

  toggleErrBtn.addEventListener('click', () => {
    showErr = !showErr;
    toggleErrBtn.textContent = showErr ? '오차 숨기기' : '오차 보기';
    draw();
  });

  speedSlider.addEventListener('input', () => {
    spf = Number(speedSlider.value);
    speedVal.textContent = String(spf);
  });

  // Initial draw
  draw();

  // Redraw on resize
  const ro = new ResizeObserver(() => draw());
  ro.observe(canvas);

  // Redraw on theme change
  const observer = new MutationObserver(() => draw());
  observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
</script>
